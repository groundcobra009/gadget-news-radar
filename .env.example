# ローカルで送信を試すときだけ使う。値はコミットしない（.env は .gitignore 済み）
# 本番（GitHub Actions）は gh secret set で登録する。

RESEND_API_KEY=

# 送信元。keitro-aigc.com のサブドメインを Resend で検証してから使う。
# ドメイン検証が済むまでは Resend のテスト送信元 onboarding@resend.dev でも動く
# （Resendアカウントの登録メール宛にだけ送れる仕様のため、MAIL_TO と一致している必要がある）。
MAIL_FROM=onboarding@resend.dev

# 配信先（本人のメール1件のみ。増やすときは承認キュー対象に戻す・DECISIONS.md 参照）
MAIL_TO=
